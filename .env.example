# Documentation only: configure these server-side environment variables.
# Teammates: read docs/START_HERE.md and docs/GROQ_SETUP.md first.
# The application does not automatically load this file.
# Never commit real API keys or place them in frontend code.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# OpenAI remains optional: select LLM_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Java adapter: restart the server after changing these.
# Keep mock mode until Java implements the proposed contract.
BACKEND_MODE=mock
BACKEND_BASE_URL=http://127.0.0.1:8081
# HTTP mode requires a backend-issued user Bearer token on each incoming API
# call. It is forwarded to Java; do not put a shared token in frontend code.
